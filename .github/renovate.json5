{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Self-contained configuration: this repo is public, while
  // `camunda/renovate-config` (the shared org preset) is internal-only and,
  // as far as we could tell, only ever consumed by internal repos. Rather
  // than depend on it, everything relevant is inlined below.
  "extends": ["config:recommended"],

  "dependencyDashboard": true,

  "labels": ["renovate"],

  "schedule": ["before 5:00am on monday"],

  "postUpdateOptions": [
    // Cleanup go.mod/go.sum after an upgrade
    "gomodTidy",
  ],

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5:00am on the first day of the month"],
  },

  "packageRules": [
    {
      // hashicorp/go-plugin pulls in the whole gRPC/x/net/protobuf stack as
      // indirect dependencies for the tflint plugin RPC transport. Group them
      // so a CVE bump (e.g. grpc + x/net together) lands as one PR instead of
      // several that need manual combining.
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "golang.org/x/**",
        "google.golang.org/**",
      ],
      "groupName": "go-plugin transport dependencies",
    },
    {
      // Renovate doesn't propose updates for indirect Go dependencies by
      // default (they normally only move via a direct dependency bump +
      // `go mod tidy`). Make an exception so CVEs in transitive deps (like
      // the grpc/x-net bumps combined in PR #86) get picked up automatically.
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true,
    },
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["🔐 security"],
    // Renovate forces groupName back to null by default for vulnerability
    // PRs, which would split a multi-package CVE fix (e.g. grpc + x-net)
    // into several PRs. Group all security PRs together instead of trying
    // to scope this per package - vulnerabilityAlerts config isn't matched
    // per packageRule, so it can't be scoped to just the go-plugin stack.
    "groupName": "security updates",
  },

  "stopUpdatingLabel": "stop-updating",
}
